# ============================================================================
# STAGING ENVIRONMENT CONFIGURATION — stage.aroedu.ir
# Copy this file to envs/.env.stage before running docker-compose.stage.yml:
#   cp envs/.env.stage.example envs/.env.stage
# ============================================================================

# --- Django Core & Security ---
DJANGO_ENV=staging
DJANGO_DEBUG=false
DJANGO_SECRET_KEY=CHANGE_ME_STAGE_64_CHAR_RANDOM_SECRET_KEY_FOR_AROEDU_IR_2026
DJANGO_ALLOWED_HOSTS=aroedu.ir,localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=https://aroedu.ir,http://aroedu.ir,http://localhost,http://localhost:8080,http://127.0.0.1:8080
DJANGO_USE_X_FORWARDED_HOST=true
DJANGO_SECURE_SSL=false
DJANGO_SECURE_SSL_REDIRECT=false
DJANGO_HSTS_SECONDS=3600
DJANGO_LOG_LEVEL=DEBUG

# --- PostgreSQL 16 Database (Staging) ---
POSTGRES_DB=aroedu_stage
POSTGRES_USER=aroedu_stage_user
POSTGRES_PASSWORD=CHANGE_ME_STRONG_STAGE_POSTGRES_PASSWORD
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_CONN_MAX_AGE=60

# --- Redis 7.4 & Automatic ORM Query Caching (Staging) ---
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=CHANGE_ME_STRONG_STAGE_REDIS_PASSWORD
REDIS_URL=redis://:CHANGE_ME_STRONG_STAGE_REDIS_PASSWORD@redis:6379/1
REDIS_ORM_CACHE_URL=redis://:CHANGE_ME_STRONG_STAGE_REDIS_PASSWORD@redis:6379/2
REDIS_KEY_PREFIX=aroedu_stage
REDIS_CACHE_TIMEOUT=300
REDIS_MAX_CONNECTIONS=80
DJANGO_SESSION_ENGINE=django.contrib.sessions.backends.cache

# --- ORM Caching (django-cachalot) ---
DJANGO_ENABLE_ORM_CACHE=true
CACHALOT_TIMEOUT=300
CACHALOT_UNCACHABLE_TABLES=django_migrations,django_session

# --- Gunicorn & Container Runtime ---
RUN_MIGRATIONS=true
RUN_COLLECTSTATIC=true
GUNICORN_WORKERS=2
GUNICORN_THREADS=2
GUNICORN_TIMEOUT=120
STAGE_HTTP_PORT=8080
STAGE_HTTPS_PORT=8443
DJANGO_STATIC_ROOT=/app/staticfiles
DJANGO_MEDIA_ROOT=/app/media
